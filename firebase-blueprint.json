{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "Transit news, updates, or tutorials for the MetroFlow app",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "titleEn": { "type": "string" },
        "summary": { "type": "string" },
        "summaryEn": { "type": "string" },
        "content": { "type": "string" },
        "contentEn": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["news", "update", "tutorial", "maintenance"]
        },
        "author": { "type": "string" },
        "publishedAt": { "type": "number" },
        "readTimeMinutes": { "type": "number" },
        "pinned": { "type": "boolean" }
      },
      "required": [
        "id",
        "title",
        "summary",
        "content",
        "category",
        "author",
        "publishedAt"
      ]
    },
    "Disruption": {
      "title": "Disruption",
      "description": "User-reported live disruption on a metro or rail line",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lineId": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "missing_tracks",
            "inactive_redstone",
            "empty_minecart",
            "construction",
            "closure"
          ]
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "fromStationId": { "type": "string" },
        "toStationId": { "type": "string" },
        "reportedBy": { "type": "string" },
        "timestamp": { "type": "number" },
        "confirmations": { "type": "number" },
        "resolvedReports": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": [
        "id",
        "lineId",
        "type",
        "title",
        "fromStationId",
        "toStationId",
        "timestamp"
      ]
    },
    "SegmentTravelTime": {
      "title": "SegmentTravelTime",
      "description": "Measured segment travel time between two adjacent stations on a line, recorded by administrators and used globally for all users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 160, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lineId": { "type": "string", "maxLength": 64 },
        "fromStationId": { "type": "string", "maxLength": 64 },
        "toStationId": { "type": "string", "maxLength": 64 },
        "durationSeconds": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": [
        "id",
        "lineId",
        "fromStationId",
        "toStationId",
        "durationSeconds",
        "durationMinutes",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Publicly readable news and tutorial articles published by transit operators"
    },
    "/disruptions/{disruptionId}": {
      "schema": "Disruption",
      "description": "Real-time crowdsourced disruption reports synchronized across all devices"
    },
    "/travelTimes/{segmentId}": {
      "schema": "SegmentTravelTime",
      "description": "Global segment travel times measured by administrators for route duration calculation"
    }
  }
}
